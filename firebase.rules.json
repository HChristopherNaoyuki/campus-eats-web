{
  "rules": {
    ".read": false,
    ".write": false,

    "admin_claims": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },

    "users": {
      ".indexOn": ["email", "role", "status"],
      "$campus_user_id": {
        ".read": "auth != null && (auth.token.admin === true || auth.token.email === data.child('email').val() || data.child('userId').val() === auth.uid)",
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && (auth.token.email === newData.child('email').val() || newData.child('userId').val() === auth.uid)) || (data.exists() && (auth.token.email === data.child('email').val() || data.child('userId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['userId', 'fullName', 'email', 'role'])",

        "userId": {
          ".validate": "newData.val() === $campus_user_id && (newData.val().length === 16 || newData.val().length === 19)"
        },
        "fullName": {
          ".validate": "newData.isString()"
        },
        "username": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "!data.exists() || data.val() === newData.val()"
        },
        "role": {
          ".validate": "(newData.val() === 'STUDENT' || newData.val() === 'VENDOR' || newData.val() === 'STANDARD' || newData.val() === 'ADMIN') && (data.val() === newData.val() || auth.token.admin === true)"
        },
        "passwordHash": {
          ".validate": "newData.val() === '[FIREBASE_SSO]'"
        },
        "walletBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "!data.exists() || data.val() === newData.val() || auth.token.admin === true"
        },
        "shopName": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "shopStatus": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "bankAccountInfo": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "registrationDate": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isNumber()"
        },
        "usercode": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        }
      }
    },

    "orders": {
      ".indexOn": ["customerId", "vendorId", "status", "timestamp"],
      "$order_id": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['orderId', 'customerId', 'vendorId', 'totalAmount', 'status'])",

        "orderId": {
          ".validate": "newData.val() === $order_id"
        },
        "customerId": {
          ".validate": "newData.isString()"
        },
        "vendorId": {
          ".validate": "newData.isString()"
        },
        "itemsJson": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "totalAmount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "paymentMethod": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "pickupTime": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString() || newData.isNumber()"
        },
        "specialRequests": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        },
        "timestamp": {
          ".validate": "!newData.exists() || newData.isNumber()"
        }
      }
    },

    "feedback": {
      ".indexOn": ["userId", "type", "status", "createdAt"],
      "$feedback_id": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['userId', 'type', 'subject', 'message', 'userName', 'userEmail', 'status', 'createdAt', 'updatedAt'])",

        "userId": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.val() === 'complaint' || newData.val() === 'compliment'"
        },
        "subject": {
          ".validate": "newData.isString()"
        },
        "message": {
          ".validate": "newData.isString()"
        },
        "userName": {
          ".validate": "newData.isString()"
        },
        "userEmail": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'resolved'"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      }
    },

    "coupons": {
      ".indexOn": ["isActive"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['code', 'discountPercent', 'isActive'])",

        "code": {
          ".validate": "newData.val() === $code"
        },
        "discountPercent": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "isActive": {
          ".validate": "newData.isBoolean()"
        },
        "expiryDate": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isNumber() || newData.isString()"
        },
        "assignedUserId": {
          ".validate": "!newData.exists() || newData.val() == null || newData.isString()"
        }
      }
    },

    "sync": {
      ".indexOn": ["lastSyncAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['lastSyncAt'])",
        "lastSyncAt": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "lastPage": {
          ".validate": "!newData.exists() || newData.val() == null || (newData.isString() && newData.val().length <= 255)"
        },
        "cartItemCount": {
          ".validate": "!newData.exists() || newData.val() == null || (newData.isNumber() && newData.val() >= 0)"
        },
        "currentOrderId": {
          ".validate": "!newData.exists() || newData.val() == null || (newData.isString() && newData.val().length <= 64)"
        },
        "currentOrderStatus": {
          ".validate": "!newData.exists() || newData.val() == null || (newData.isString() && newData.val().length <= 32)"
        }
      }
    }
  }
}