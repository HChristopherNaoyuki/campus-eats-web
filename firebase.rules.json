{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$campus_user_id": {
        ".read": "auth != null && (auth.uid === $campus_user_id || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".write": "auth != null && (auth.uid === $campus_user_id || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".validate": "newData.hasChildren(['email', 'role', 'passwordHash'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || data.val() === newData.val())"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'STUDENT' || newData.val() === 'STANDARD' || newData.val() === 'VENDOR' || newData.val() === 'ADMIN') && (!data.exists() || data.val() === newData.val() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
        },
        "passwordHash": {
          ".validate": "newData.isString() && newData.val() === '[FIREBASE_SSO]'"
        },
        "fullName": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "uniqueId": {
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    },

    "orders": {
      "$order_id": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'VENDOR')",
        ".write": "auth != null && (newData.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'VENDOR')",
        ".indexOn": ["userId", "vendorId", "status"]
      }
    },

    "feedback": {
      "$feedback_id": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".indexOn": ["userId", "createdAt"]
      }
    },

    "coupons": {
      "$coupon_code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'",
        ".validate": "newData.hasChildren(['discountPercent', 'isActive'])"
      }
    },

    "sync": {
      "$firebase_uid": {
        ".read": "auth != null && auth.uid === $firebase_uid",
        ".write": "auth != null && auth.uid === $firebase_uid",
        ".validate": "newData.hasChildren(['lastSyncAt'])",
        "lastPage": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "lastSyncAt": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "cartItemCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "currentOrderId": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "currentOrderStatus": {
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    }
  }
}