# =============================================================================
# Campus Eats - Apache Access Control Configuration
# =============================================================================
# This file prevents direct access to sensitive directories and files.
# 
# CORRECTIONS (Version 3.0 - Critical Fix):
# - Added protection for all sensitive directories (CRIT-03)
# - Denies access to Issues/, Documentation/, Solution/config/, Solution/sql/
# - Denies access to .git/ and .github/
# - Denies access to sensitive configuration files
# - Prevents directory listing
# 
# @version 3.0
# =============================================================================

# =============================================================================
# Options
# =============================================================================

Options -Indexes
Options +FollowSymLinks

# =============================================================================
# Turn on URL rewriting
# =============================================================================

RewriteEngine On

# =============================================================================
# Deny access to sensitive directories
# =============================================================================

# Deny access to Issues/ directory (contains error logs)
RewriteRule ^Issues/ - [F,L]

# Deny access to Documentation/ directory (contains process documents)
RewriteRule ^Documentation/ - [F,L]

# Deny access to Solution/config/ directory (contains configuration files)
RewriteRule ^Solution/config/ - [F,L]

# Deny access to Solution/sql/ directory (contains SQL scripts)
RewriteRule ^Solution/sql/ - [F,L]

# Deny access to Solution/data/ directory (contains data files)
RewriteRule ^Solution/data/ - [F,L]

# Deny access to .git/ and .github/ directories
RewriteRule ^\.git/ - [F,L]
RewriteRule ^\.github/ - [F,L]

# Deny access to any directory starting with . (hidden directories)
RewriteRule ^\..* - [F,L]

# =============================================================================
# Deny access to specific sensitive files
# =============================================================================

# Deny access to configuration files
<Files "constants.php">
    Require all denied
</Files>

<Files "database.php">
    Require all denied
</Files>

<Files "error_logging.php">
    Require all denied
</Files>

<Files "demo_accounts.php">
    Require all denied
</Files>

# Deny access to SQL files
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# Deny access to log files
<FilesMatch "\.log$">
    Require all denied
</FilesMatch>

# Deny access to .env files
<Files ".env">
    Require all denied
</Files>

# =============================================================================
# Allow access to public files
# =============================================================================

# Allow access to index.php and other public PHP files
<Files "index.php">
    Require all granted
</Files>

<Files "about.php">
    Require all granted
</Files>

<Files "faq.php">
    Require all granted
</Files>

<Files "help.php">
    Require all granted
</Files>

<Files "privacy.php">
    Require all granted
</Files>

<Files "terms.php">
    Require all granted
</Files>

# Allow access to Solution/ files (modules, includes, api, assets)
<LocationMatch "^/Solution/(modules|includes|api|assets)/">
    Require all granted
</LocationMatch>

# =============================================================================
# Error Documents
# =============================================================================

ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 500 /error.php

# =============================================================================
# Security Headers (if mod_headers is enabled)
# =============================================================================

<IfModule mod_headers.c>
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>